# URL base da API do backend (Express). Em produção, aponta para o
# projeto Vercel do backend; em dev local, para o servidor Express local.
VITE_API_URL=http://localhost:4000/api

# Nome do parâmetro de query que o PagBank devolve na URL de retorno
# do checkout, usado para identificar o pedido pago. Ajustar assim que
# o suporte do PagBank confirmar o nome real do parâmetro.
VITE_ORDER_ID_PARAM=order_id
